# 前端环境变量 —— 只有这两个，且都不是密钥。
# VITE_ 前缀会被打包进产物，因此这里绝不允许出现任何 Access Secret / App Key / Token。

# mock = 读本地 fixture（开发默认）；live = 走真实后端
VITE_API_MODE=mock

# 后端前缀；开发期与 vite proxy 配合（见 vite.config.ts）
VITE_API_BASE=/api/v1

# ------------------------------------------------------------------
# live 联调：不要改本文件（会污染仓库）。
# 本地新建 apps/web/.env.local（已被根 .gitignore 的 .env.* 忽略）写：
#   VITE_API_MODE=live
# Vite 中 .env.local 优先级高于本文件，后端跑在 127.0.0.1:3000 时
# vite dev 的 /api 反代（见 vite.config.ts）会自动生效。
# ------------------------------------------------------------------
