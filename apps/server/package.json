{
  "name": "@two-sides/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "两面 · 后端：Bun + Hono + bun:sqlite",
  "scripts": {
    "dev": "bun --watch run src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build --target=bun --outdir dist src/index.ts",
    "typecheck": "tsc --noEmit",
    "seed": "bun run src/seed.ts"
  },
  "dependencies": {
    "@two-sides/contract": "workspace:*",
    "hono": "^4.6.14",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "typescript": "^5.6.3"
  }
}
