# ============================================================
# 两面（Two Sides）—— 环境变量模板
#
# 用法：cp .env.example .env 后填入真实值。
# 本文件只包含占位符，严禁写入任何真实密钥。
# .env 已被 .gitignore 忽略，不会进仓库。
# ============================================================

# ---------- 知乎开放平台 ----------
# 知乎开放平台 Access Secret（服务端签名用，绝不能下发到前端）
ZHIHU_ACCESS_SECRET=
# 知乎直答模型名
ZHIHU_ZHIDA_MODEL=zhida-thinking-1p5

# ---------- 知乎 OAuth 增强层 ----------
# OAuth 应用 ID
ZHIHU_OAUTH_APP_ID=
# OAuth 应用 Key
ZHIHU_OAUTH_APP_KEY=
# OAuth 回调地址，需与开放平台配置一致
ZHIHU_OAUTH_REDIRECT_URI=https://twosides.haori.ink/callback

# ---------- 外部 LLM ----------
# DeepSeek（主力分析模型）
DEEPSEEK_API_KEY=
# 智谱 GLM（交叉验证模型）
GLM_API_KEY=
# 通义千问 Qwen（交叉验证模型）
QWEN_API_KEY=
# origami 中转端点（OpenAI 兼容，config/providers.yaml 的 baseUrl 为非涉密字面量）
ORIGAMI_API_KEY=

# ---------- 管线运行开关（server 新增，见 apps/server/src/env.ts） ----------
# 真实外部调用总闸：生产设为 1；本地演示可显式设为 0
ZHIHU_LIVE=1
# 管线模式：llm=真实模型管线（默认）；fake=确定性假实现（仅显式开启）
PIPELINE_MODE=llm
# fake 管线单阶段推进时长（毫秒），用于本地演示 T1 进度节奏
PIPELINE_FAKE_DURATION_MS=
# 启动时是否扫描当日 pending/generating 的 job 重入队
RECOVER_ON_BOOT=1

# ---------- 运行时 ----------
# 时区
TZ=Asia/Shanghai
# 服务端监听端口
SERVER_PORT=3000
# SQLite 数据库文件路径
ZHIDUAN_DB_PATH=./data/two-sides.db
# 内部服务间调用令牌（自行生成随机串）
INTERNAL_TOKEN=
# 同一问题分析失败后的冷却秒数
ANALYSIS_RETRY_COOLDOWN_SEC=60
# 单个分析任务的超时秒数。
# 2026-09-13 起默认 600：产品入口只剩热榜（无用户输入），单题不再受交互延迟约束，
# 全部在 00:30 预生成，放宽预算让更大的样本池与更完整的两轮分析跑得下。
ANALYSIS_JOB_TIMEOUT_SEC=600
# 外部 LLM 每分钟请求上限
# 全局 LLM 每分钟请求上限（默认 1000；API 承载不足时可调低）
LLM_RPM_LIMIT=1000
# 管线并发（默认提取 30、取向 100、预生成跨题 4；按服务商承载调节）
PIPELINE_EXTRACT_CONCURRENCY=30
PIPELINE_ORIENT_CONCURRENCY=100
PREGENERATE_CONCURRENCY=4
# 单题检索路数上限（1–4）：原句 + LLM 扩写的相似问法。
# 默认 4 → 单题样本池从「单次搜索 ≤10 条」提到「≤4 路去重 ≤40 条」。设 1 退回单路。
PIPELINE_QUERY_VARIANTS=4
# 启动补生成 / 每日 00:30（Asia/Shanghai）预生成题数；0 关闭自动预生成
PREGENERATE_TOP=30

# ---------- 增强层 · 「与你有关」标记（需 OAuth 登录，未配置整层不启用） ----------
# 扫用户的收藏夹得出「收藏过这道题 / 收藏过这题里的回答」，标在 N1 热榜卡与 N2 问题页
# 收藏夹按新→旧排序，只需最近若干条即覆盖当日热榜，故默认只扫第 1 页
ZHIHU_FAV_SCAN_LISTS=5
ZHIHU_FAV_SCAN_PAGES=1
ZHIHU_FAV_PAGE_SIZE=50
# 同一会话内不重复扫收藏的缓存时长（秒）
USER_SIGNAL_TTL_SEC=600

# ---------- 前端（Vite，变量名以 VITE_ 开头才会注入浏览器） ----------
# 接口模式：live=真实接口，mock=本地假数据
VITE_API_MODE=live
# 接口基础路径
VITE_API_BASE=/api/v1
