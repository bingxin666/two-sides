# ============================================================
# 两面（Two Sides）—— 环境变量模板
#
# 用法：cp .env.example .env 后填入真实值。
# 本文件只包含占位符，严禁写入任何真实密钥。
# .env 已被 .gitignore 忽略，不会进仓库。
# ============================================================

# ---------- 知乎开放平台 ----------
# 知乎开放平台 Access Secret（服务端签名用，绝不能下发到前端）
ZHIHU_ACCESS_SECRET=
# 知乎直答模型名
ZHIHU_ZHIDA_MODEL=zhida-thinking-1p5

# ---------- 知乎 OAuth 增强层 ----------
# OAuth 应用 ID
ZHIHU_OAUTH_APP_ID=
# OAuth 应用 Key
ZHIHU_OAUTH_APP_KEY=
# OAuth 回调地址，需与开放平台配置一致
ZHIHU_OAUTH_REDIRECT_URI=

# ---------- 外部 LLM ----------
# DeepSeek（主力分析模型）
DEEPSEEK_API_KEY=
# 智谱 GLM（交叉验证模型）
GLM_API_KEY=
# 通义千问 Qwen（交叉验证模型）
QWEN_API_KEY=
# origami 中转端点（OpenAI 兼容，config/providers.yaml 的 baseUrl 为非涉密字面量）
ORIGAMI_API_KEY=

# ---------- 管线运行开关（server 新增，见 apps/server/src/env.ts） ----------
# 真实外部调用总闸：0=全 fake（不烧任何额度），1=放行知乎/LLM 真实调用。默认 0
ZHIHU_LIVE=0
# 管线模式：fake=确定性假实现（D0），llm=真实模型管线（D1）
PIPELINE_MODE=fake
# fake 管线单阶段推进时长（毫秒），用于本地演示 T1 进度节奏
PIPELINE_FAKE_DURATION_MS=
# 启动时是否扫描当日 pending/generating 的 job 重入队
RECOVER_ON_BOOT=1

# ---------- 运行时 ----------
# 时区
TZ=Asia/Shanghai
# 服务端监听端口
SERVER_PORT=3000
# SQLite 数据库文件路径
ZHIDUAN_DB_PATH=./data/two-sides.db
# 内部服务间调用令牌（自行生成随机串）
INTERNAL_TOKEN=
# 同一问题分析失败后的冷却秒数
ANALYSIS_RETRY_COOLDOWN_SEC=60
# 单个分析任务的超时秒数
ANALYSIS_JOB_TIMEOUT_SEC=180
# 外部 LLM 每分钟请求上限
LLM_RPM_LIMIT=60
# 每日 00:30（Asia/Shanghai）进程内 cron 预生成的热榜题数（docs/04）
PREGENERATE_TOP=30

# ---------- 前端（Vite，变量名以 VITE_ 开头才会注入浏览器） ----------
# 接口模式：live=真实接口，mock=本地假数据
VITE_API_MODE=live
# 接口基础路径
VITE_API_BASE=/api/v1
