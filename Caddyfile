# 两面 · Caddy 站点配置
# 手动部署参考；Docker 镜像实际打包 apps/web/Caddyfile。
#
# 职责二选一，不做别的：
#   1. 静态托管 Vue 构建产物（root * /srv）
#   2. /api/* 和 /callback 反代到 server:3000
#
# 不签证书、不占 443：对外 HTTPS 由宿主侧反代终止后转发到 127.0.0.1:8080

:8080 {
	root * /srv
	encode zstd gzip

	# API 与 OAuth 回调全部走后端
	# 主端点返回 202 + 进度，无长挂请求，故不额外调整反代超时
	handle /api/* {
		reverse_proxy server:3000
	}

	# OAuth provider callback (registered URI: https://<domain>/callback)
	handle /callback {
		reverse_proxy server:3000
	}

	# SPA 回退：非 /api 的未知路径交回 index.html，由 vue-router 接管
	handle {
		try_files {path} /index.html
		file_server
	}

	# 不记录访问 URL，避免 OAuth 回调的 code/state 进入日志。
}
