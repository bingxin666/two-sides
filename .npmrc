# ============================================================
# 两面 · pnpm 配置
#
# 依赖构建脚本（esbuild / vue-demi）的放行在 pnpm-workspace.yaml 的
# allowBuilds 中维护 —— 经验证独立生效：`pnpm install` 干净退出（exit 0），
# `pnpm rebuild` 与 `pnpm -F @two-sides/web build` 均通过。
# 此处不再做任何全局覆写，保持新克隆环境与 CI 行为一致。
# ============================================================

# peer 版本不一致（vue-demi ↔ vue）不视为安装失败
strict-peer-dependencies=false
