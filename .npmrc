# ============================================================
# 两面 · pnpm 配置
# ============================================================

# pnpm 11 会在执行 `pnpm -F <pkg> <script>` 前自动跑一次 `pnpm install`（前置依赖检查）。
# 本项目在 install 期会输出 ERR_PNPM_IGNORED_BUILDS（esbuild / vue-demi 的构建脚本被拦截），
# 导致那次自动 install 以 exit 1 结束，进而**阻断所有脚本**。
# 关掉前置检查即可正常执行；依赖本身已完整安装（esbuild 平台二进制由
# optionalDependencies @esbuild/win32-x64 提供，实测 `esbuild --version` 正常）。
verify-deps-before-run=false

# 依赖图里存在少量 peer 版本不一致（vue-demi ↔ vue），不影响运行，不因它中断安装
strict-peer-dependencies=false
